# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Python files
*.py text eol=lf
*.pyw text eol=lf

# Cpp files
*.cpp text eol=lf
*.h text eol=lf

# Config / data files
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Script files
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Spec file (PyInstaller)
*.spec text eol=lf
Dockerfile text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
adb/linux/adb binary
adb/linux/fastboot binary
adb/linux/etc1tool binary
adb/linux/hprof-conv binary
adb/linux/make_f2fs binary
adb/linux/make_f2fs_casefold binary
adb/linux/mke2fs binary
adb/linux/sqlite3 binary
adb/linux/lib64/libc++.so binary
scrcpy-server binary
