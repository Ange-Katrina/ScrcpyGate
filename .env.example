# ScrcpyGate deployment example.
# Copy to .env or export these variables before running deploy.sh.

WEB_SCRCPY_BIND=127.0.0.1
WEB_SCRCPY_PORT=5000
WEB_SCRCPY_DATA_HOST=./data
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Installer-only startup health timeout, in seconds (10-600).
SCRCPYGATE_HEALTH_TIMEOUT=90

# Set these when using a reverse proxy / WAF.
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:5000
ALLOW_NULL_ORIGIN=false
TRUST_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
SESSION_COOKIE_SECURE=false
ENABLE_API_DOCS=false

# Password policy.
MIN_PASSWORD_LENGTH=12
PASSWORD_PBKDF2_ITERATIONS=310000

# Login brute-force protection.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=6
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=600

# Network ADB.
ADB_AUTOCONNECT=true
ADB_HEARTBEAT_INTERVAL=15
ADB_CONNECT_TIMEOUT=8
ADB_RECONNECT_BACKOFF=5
ADB_HEARTBEAT_CONCURRENCY=4

# Keep raw as the safe default. Enable protocol/legacy later in the admin UI only after testing.
SCRCPY_STREAM_MODE=raw
SCRCPY_STREAM_HEALTH_TIMEOUT=5
SCRCPY_I_FRAME_INTERVAL=1
SCRCPY_SOCKET_READY_TIMEOUT=8
VIDEO_RESET_COOLDOWN=0.75
CONTROL_LEASE_VERIFY_INTERVAL=0.5
VIDEO_QUEUE_MAXSIZE=24
VIDEO_QUEUE_SOFT_LIMIT=8

LOG_LEVEL=INFO
