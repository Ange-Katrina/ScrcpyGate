# ScrcpyGate deployment example.
# Copy to .env or export these variables before running deploy.sh.
#
# 重要：应用进程**从不读取本文件**（没有 dotenv 装载）。真正生效的只有两条路径：
#   1) docker compose 自动读项目根的 .env，做 ${VAR} 插值后注入容器环境；
#   2) deploy.sh 用内置解析器按名字取值（不会 source 整个文件）。
# 所以直接 `python -m uvicorn app.main:app` 时这些变量必须自己 export / $env: 出来。
# 模板与代码的漂移由人工核对：改这里时同步 app/storage_core.py 的 ALLOWED 名单与
# compose.yaml 的 environment: 转发项（原先守这条的契约测试已随仓库瘦身移除）。

# 监听地址/端口。两种部署方式共用：
#   1) compose（默认）：compose.yaml 用 ports: "${BIND}:${PORT}:5000" 做映射，容器内部
#      始终监听 0.0.0.0:5000 —— 改这两行只改「宿主侧」暴露位置；
#   2) 宿主网络（docker run --net=host 或 compose.host.yaml）：没有端口映射，容器直接用
#      这两个值绑在宿主上，此时它们必须与 PUBLIC_BASE_URL 一致。
WEB_SCRCPY_BIND=127.0.0.1
WEB_SCRCPY_PORT=5000
# 宿主数据目录（挂到容器 /app/data）。属主有讲究：容器以 uid 100(app):gid 101(app)
# 运行，手工 `docker compose up` 之前要先
#   mkdir -p ./data && sudo chown -R 100:101 ./data
# 否则容器启动即 PermissionError: '/app/data/.init-db.lock' 并反复重启
# （deploy.sh 自己会做这一步；实测过：root 属主 + 非 root 容器的组合必挂）。
WEB_SCRCPY_DATA_HOST=./data
PUBLIC_BASE_URL=http://127.0.0.1:5000
# 镜像构建参数（deploy.sh 也会从 .env 读 PYTHON_IMAGE；PIP_INDEX_URL 只给 compose build）。
# 国内网络建议填镜像源（实测 pypi.org 在该网络只有 ~365 KB/s，46 MB 的 simple 索引
# 会把构建卡死；清华源 2 s 内返回）：
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PYTHON_IMAGE=python:3.12-alpine
PIP_INDEX_URL=
# 要跑哪个镜像。留空 = 用本地 build 出来的 scrcpygate:local；
# 正式发布建议钉不可变引用（CI 会输出 digest）：
#   SCRCPYGATE_IMAGE=ghcr.io/<owner>/scrcpygate@sha256:<digest>
# 改了它要 `docker compose pull scrcpygate` 再 `up -d --no-build`，
# 或者直接用 tools/deploy_release.sh（带健康门 + 失败自动回滚）。
SCRCPYGATE_IMAGE=
# `deploy.sh --update` 的目标镜像（tag 或 @sha256:digest）。留空 = 用
# ghcr.io/ange-katrina/scrcpygate:latest。验证 dev 分支功能使用 :dev，main 使用 :edge。
# 成功更新（含镜像已相同）后，脚本会记住所选目标，后续 --update 继续跟随该目标。
# --update 拉取后比较实际镜像，更新前备份数据库、配套密钥与 .env；
# 只换镜像，失败尝试恢复原镜像，不自动回退数据库迁移。当前适用于 bridge 部署。
SCRCPYGATE_UPDATE_IMAGE=
# 旧部署兼容标记：--update 可写入此值，但应用优先读取镜像内的 VERSION。
# 本地构建也读取源码 VERSION，不会用此字段覆盖。通常保持为空。
SCRCPYGATE_VERSION=
# --- 首次启动的管理员密码 ---
# 只在「库里还没有 admin 账号」时被消费一次，之后改这里不会改密码。
# * 留空：默认将生成的密码保存到 data/initial_admin_password.txt（0600，下次初始化删除）。
#   若未保存该密码，请使用显式授权输出的 reset-admin 命令恢复访问。
# * deploy.sh --install 会替你 bootstrap 并把密码打在终端上，所以它不需要这一项。
# * 手工 `docker run` / `docker compose up` 请显式设置（>= MIN_PASSWORD_LENGTH 位）。
INITIAL_ADMIN_PASSWORD=
# 允许上面那个 CLI 把生成的密码打到 stdout（只影响 bootstrap-admin / reset-admin）。
SCRCPYGATE_SHOW_GENERATED_PASSWORD=false
# 首次初始化时若没有 INITIAL_ADMIN_PASSWORD：把自动生成的密码写进数据目录的
# initial_admin_password.txt（0600，下次启动即删除），避免"生成了却无处可取"把人锁在外面。
# 设为 false 可关闭（则只能用 `python -m app.cli reset-admin` 找回）。
SCRCPYGATE_ADMIN_PASSWORD_FILE=true
# --- 安装器专用：以下开关由 deploy.sh 自己消费（应用进程不读） ---
# Management-panel display only. Addresses are shown by default for deployment
# confirmation; set either value to false to mask that address in terminal UI.
SCRCPYGATE_SHOW_PUBLIC_HOST=true
SCRCPYGATE_SHOW_PRIVATE_IPS=true
# Optional isolated ALAS origin. Keep empty for the default production profile:
# Gateway is disabled and no separate Gateway listener/site is required.
# If enabled later, use a separate HTTPS origin and run the Gateway-specific acceptance checks.
ALAS_EMBED_ORIGIN=

# Installer-only startup health timeout, in seconds (10-600).
SCRCPYGATE_HEALTH_TIMEOUT=90

# deploy.sh --backup / --list-backups 的默认备份目录（相对部署目录）。
# 归档含数据库在线快照、ALAS 令牌密钥与清单，因此默认 0600 且不要放进版本库。
SCRCPYGATE_BACKUP_DIR=./backups
# 备份保留份数（留空 = 不清理）。小磁盘可设 3，下次创建备份时清理更旧的常规/更新备份。
# 不会清理恢复前归档或 Docker 回滚镜像。也可用 --backup --keep N 单次覆盖。
SCRCPYGATE_BACKUP_KEEP=

# Base image connectivity fallback used by deploy.sh. `auto` probes IPv6
# first, switches to IPv4 after a timeout, then tries the mirrors in order.
# Docker Engine has no per-pull address-family flag; the setting controls the
# probe/retry preference and bounds a failed pull before the next candidate.
# Keep the official image reference unless the registry is unreachable.
SCRCPYGATE_REGISTRY_IP_FAMILY=auto
SCRCPYGATE_REGISTRY_CONNECT_TIMEOUT_SECONDS=8
SCRCPYGATE_IMAGE_PULL_TIMEOUT_SECONDS=120
SCRCPYGATE_PYTHON_IMAGE_MIRRORS=docker.m.daocloud.io/library/python:3.12-alpine,docker.1ms.run/library/python:3.12-alpine

# Set these when using a reverse proxy / WAF.
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:5000
# A WAF/reverse proxy should preserve the browser Origin. Keep null and
# missing WebSocket Origin disabled unless a reviewed compatibility exception
# is required.
ALLOW_NULL_ORIGIN=false
ALLOW_MISSING_WEBSOCKET_ORIGIN=false
TRUST_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Leave empty to follow PUBLIC_BASE_URL (https=true, http=false).
SESSION_COOKIE_SECURE=
ENABLE_API_DOCS=false

# Application-layer body limits. Configure matching or stricter limits at the reverse proxy.
API_REQUEST_BODY_MAX_BYTES=1048576
# Per-chunk request-body idle timeout (1-300 seconds); size limits still return 413.
REQUEST_BODY_IDLE_TIMEOUT_SECONDS=15
ALAS_UPSTREAM_RESPONSE_MAX_BYTES=16777216
# Independent cap on decompressed ALAS responses (gzip bomb protection).
ALAS_UPSTREAM_DECOMPRESSED_MAX_BYTES=67108864
SCRCPYGATE_WS_MAX_SIZE=65536
# ALAS policy message and traversal budgets. Values are clamped by the application.
ALAS_WS_MESSAGE_MAX_BYTES=1048576
ALAS_POLICY_MAX_DEPTH=128
ALAS_POLICY_MAX_NODES=20000
ALAS_POLICY_REGISTRY_MAX_ENTRIES=16384
# ALAS outbound policy. Production should replace the default private-network policy
# with the exact Runtime host route, e.g. ALAS_ALLOWED_CIDRS=192.0.2.8/32.
ALAS_ALLOWED_HOSTS=
ALAS_ALLOWED_CIDRS=
# Production must inject valid 32-byte current/previous keys (hex or URL-safe
# base64) from the external Secret Manager. Never put key values in this file.
# For local/test installs, deploy.sh creates this protected file once in the
# configured data directory; the web UI can then update the Runtime Token
# without another server-side key edit. Do not expose or copy this file.
# An externally injected ALAS_TOKEN_ENCRYPTION_KEY always takes precedence.
# Inject ALAS_TOKEN_ENCRYPTION_KEY_PREVIOUS only during the migration window;
# remove it before the final --token-status production gate.
ALAS_TOKEN_ENCRYPTION_KEY=
ALAS_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# 注：应用还读 ALAS_TOKEN_ENCRYPTION_KEY_FILE（指定受保护密钥文件路径），但
# compose.yaml 用字面量固定为 /app/data/.alas-token-encryption-key（不做 ${} 插值），
# 所以它写在这里也不会生效 —— 容器内部只有挂载的数据目录会影响它。

# Run this read-only gate before a WAF/TLS production deployment:
#   ./deploy.sh --check-production
# After migration and previous-key removal, verify the redacted runtime state:
#   ./deploy.sh --token-status

# Password policy.
MIN_PASSWORD_LENGTH=12
PASSWORD_PBKDF2_ITERATIONS=310000

# 单账户并发登录会话上限（0 = 不限制）。超出时在**登录那一刻**淘汰最旧的会话，
# 不产生任何每请求开销；被淘汰的浏览器下次请求即失效。
# 管理端「安全机制 → 登录会话」可查看全部会话（含来源 IP / 客户端 / 最近活动）并按会话踢出。
MAX_SESSIONS_PER_USER=5
# 登录会话列表最多展示多少行（纯展示上限，1-500）。
SESSION_LIST_LIMIT=200

# Login brute-force protection.
# 策略：失败 1 次即要求 内置 PoW 点击验证；15 分钟窗口内第 3 次失败
# 按来源 IP 封禁 5 分钟（封禁期内连正确密码也拒绝）；解禁后计数仍在窗口内，
# 继续要求验证码；成功登录清零。失败计数与封禁落 SQLite，重启/发版不清零。
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
# Default: our own PoW. Optional providers require a separately installed adapter
# exporting a scrcpygate.pow entry point and its own client.js. Restart to switch.
# No ALTCHA/Cap implementation is bundled. A missing adapter fails startup.
LOGIN_POW_PROVIDER=builtin
LOGIN_CAPTCHA_ENABLED=true
LOGIN_CAPTCHA_AFTER_FAILURES=1
LOGIN_CAPTCHA_TTL_SECONDS=120
# 同一次挑战可重发的间隔（秒，0-60）：防止脚本反复索取新挑战。
LOGIN_CAPTCHA_ISSUE_INTERVAL_SECONDS=2
# 工作量证明难度阶梯（bits，期望 2^bits 次 SHA-256）：首题 LOGIN_CAPTCHA_BITS_BASE，
# 之后每多失败一次 +STEP，封顶 MAX。默认 14/2/18 与历史行为完全一致；每 +1 bit 让
# 攻击者的单次尝试成本翻倍（合法用户也会同步变慢，界面里有本机试算可参考）。
LOGIN_CAPTCHA_BITS_BASE=14
LOGIN_CAPTCHA_BITS_STEP=2
LOGIN_CAPTCHA_BITS_MAX=18

# Network ADB.
# ADB_AUTOCONNECT only gates the `adb connect` fallback. The heartbeat below
# always runs (read-only TCP probe + `adb get-state`), so device status stays
# fresh even when autoconnect is off; connect such devices on the host first.
# ADB_PATH 默认空：留空时先按 PATH 查找 `adb`（镜像里由 android-tools 提供
# /usr/bin/adb），找不到才回落到仓库自带的 adb/linux/adb —— 后者是 glibc 构建，
# 在 Alpine 镜像内无法执行，只对非 Alpine 宿主有意义。Windows 或自定义安装需要
# 写成绝对路径（必须是已存在的文件，否则忽略并回落到自动查找）。
ADB_PATH=
# 复用宿主已有的 adb server（USB 直连时宿主 `adb devices` 已能看到手机）：
#   ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
# 只有宿主网络下 127.0.0.1 才指向宿主（--net=host / compose.host.yaml）；bridge 模式下
# 它指向容器自己，填了反而连不上。留空 = 容器内自己起 adb server。
ADB_SERVER_SOCKET=
ADB_AUTOCONNECT=true
ADB_HEARTBEAT_INTERVAL=15
# One heartbeat pass runs during startup (bounded by this timeout in seconds)
# so the first page load already shows real device state. 0 = skip it.
ADB_STARTUP_PROBE_TIMEOUT=10
ADB_CONNECT_TIMEOUT=8
ADB_RECONNECT_BACKOFF=5
ADB_HEARTBEAT_CONCURRENCY=4
# 设备转屏跟随：轮询 mCurrentOrientation 的间隔（秒，最小 1；0 = 关闭跟随）。
# 关闭后画面不会随设备转屏重建采集，投屏期间设备转屏要手动重开观看。
ADB_ROTATION_POLL_INTERVAL=3

# Keep raw as the safe default. Enable protocol/legacy later in the admin UI only after testing.
SCRCPY_STREAM_MODE=raw
SCRCPY_STREAM_HEALTH_TIMEOUT=5
# HTTP start returns once ADB/scrcpy transport is ready; the browser finishes
# first-frame negotiation over WebSocket within this warm-up window.
SCRCPY_STREAM_START_RESPONSE_TIMEOUT=0.5
SCRCPY_I_FRAME_INTERVAL=1
# 与上游 scrcpy 默认一致的编码器提示（priority=0 realtime / latency=1 排队 1 帧即输出）。
# 设为 0/false/no/off 可整体退回，用于真机 A/B 或不吃这套提示的编码器。
SCRCPY_LOW_LATENCY_ENCODER_HINTS=1
# scrcpy server 的日志级别（VERBOSE/DEBUG/INFO/WARN/ERROR）。默认 VERBOSE：
# 实测每会话仅 8 行（INFO 为 2 行）且不含逐帧输出，多出来的正是「选中的编码器型号」
# 与「实际生效的 video_codec_options」这类排障关键行；需要安静时调成 INFO/ERROR。
SCRCPY_SERVER_LOG_LEVEL=VERBOSE
SCRCPY_SOCKET_READY_TIMEOUT=8
SCRCPY_ADB_COMMAND_TIMEOUT=15
SCRCPY_CONTROL_SEND_TIMEOUT_SECONDS=3
SCRCPY_SOCKET_KEEPALIVE=true
SCRCPY_SOCKET_KEEPALIVE_IDLE=30
SCRCPY_SOCKET_KEEPALIVE_INTERVAL=10
SCRCPY_SOCKET_KEEPALIVE_COUNT=3
MIRROR_VIEWER_RESERVATION_TTL=15
MIRROR_VIEWER_DISCONNECT_GRACE=5
# 多端投屏记录（管理员发起，邀请同设备的其他观看端一起记录）：
#   会话只在内存里（TTL 秒），停止后开放上传窗口（grace 秒），服务端只做实时转发、不落盘。
MIRROR_RECORD_TTL_SECONDS=900
MIRROR_RECORD_UPLOAD_GRACE_SECONDS=20
# 上传防护上限：记录**完整透传**（不做字段裁剪），上限只用于防滥用，超了会有明确报错。
MIRROR_RECORD_UPLOAD_MAX_BYTES=2097152
# API_REQUEST_BODY_MAX_BYTES also limits the entire upload request (default 1 MiB).
# To accept a larger timeline, allow room for its session/client JSON envelope there.
MIRROR_RECORD_MAX_ENTRIES=20000
MIRROR_RECORD_MAX_PARTICIPANTS=12
# 会话事件复查间隔（秒）：长连接期间多用户/权限变化的复查周期。
EVENT_SESSION_RECHECK_SECONDS=10
# Bound cancellation cleanup for a scrcpy start worker (1-60 seconds).
MIRROR_CANCEL_CLEANUP_TIMEOUT_SECONDS=10
VIDEO_RESET_COOLDOWN=0.75
CONTROL_LEASE_VERIFY_INTERVAL=5
VIDEO_QUEUE_MAXSIZE=24
VIDEO_QUEUE_SOFT_LIMIT=0
CONTROL_PERMISSION_RECHECK_INTERVAL=5
VIDEO_QUEUE_MAX_BYTES=8388608
SCRCPY_RAW_MAX_NAL_BYTES=8388608
SCRCPY_RAW_MAX_FRAME_BYTES=16777216
SCRCPY_RAW_MAX_PACKET_BYTES=25165824
# Video viewer hardening: periodic view-permission recheck, slow-reader send timeout, per-user WS cap.
VIDEO_PERMISSION_RECHECK_SECONDS=10
VIDEO_SEND_TIMEOUT_SECONDS=3
MAX_VIDEO_CONNECTIONS_PER_USER=4

# Structured runtime logging. Docker's local driver rotates stdout independently.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_QUEUE_SIZE=2048
LOG_MAX_BYTES=5242880
AUDIT_QUEUE_SIZE=512
# 访问记录（VIS）采集队列容量：满则采样丢弃并计数（后台会显示「记录不完整」，不会把采样数当总数）。
# 队列由独立单写线程批量落库，不与审计写入争抢 SQLite 写锁。
ACCESS_LOG_QUEUE_SIZE=4096
# ---------------------------------------------------------------------------
# 地域限制（GEO，可选功能）
# ---------------------------------------------------------------------------
# 默认**关闭**（off）：安装与升级都不会自动开启拦截。三档：
#   off     不介入任何请求；
#   observe 只记录「本来会被拒绝」的来源（访问记录里标记 observe_geo），不拦人；
#   enforce 清单外的国家/地区返回 403 geo_access_denied。
# 界面上的设置（/security → 地域限制）优先于这里的默认值，DB 里的值生效后本文件的改动不再影响运行。
GEO_MODE=off
# 允许访问的国家/地区（两位 ISO 码，逗号分隔）。HK、MO、TW 与 CN 是彼此独立的值：
# 只写 CN 不会连带放行港澳台。可在界面上修改。
GEO_ALLOWED_COUNTRIES=CN
# 无法定位国家时的处理：deny（默认，安全优先）或 allow。
# 注意：内网地址（192.168.x / 10.x / 环回）无法定位国家，也会走这一条——
# 局域网部署若开启 enforce，务必把内网网段写进 GEO_ALLOW_CIDRS，否则内网用户会被一起拒绝。
GEO_UNKNOWN_ACTION=deny
# 运维例外网段（CIDR，逗号分隔）：这些地址不受国家限制（仍然受 IP 封禁约束，封禁优先）。
# 例：GEO_ALLOW_CIDRS=192.168.0.0/16,10.0.0.0/8
GEO_ALLOW_CIDRS=
# 自动更新默认下载 GeoLite2 City：可显示国家、省份和城市，仍按国家代码执行地域限制。
# 后台可分别开关 Country / City；两项都关闭仅暂停下载，已有库仍受过期与清理规则约束。
# 下载选项与 HTTP/HTTPS 代理保存到数据卷私有 .geo-downloads.json（0600），无需新增环境变量。
# 默认跟随服务器代理；也可选择直连或自定义代理。仅管理员可查看已保存地址，备份需按凭据保护。
# 兼容已有 GeoLite2/GeoIP2 Country 库；下载成功前继续使用旧库。城市库与凭据不随镜像分发。
# MMDB 所在目录。默认放在数据卷内的可写子目录，容器内的自动更新需要写权限（原子替换）。
# 若改用外部只读挂载（例如 `./geoip:/app/data/geoip:ro`）来满足再分发条款，
# 请同时设置 GEO_UPDATE_ENABLED=false：只读目录里无法原子替换。
GEO_DATABASE_DIR=/app/data/geoip
# 可在安全设置 → 地域限制 → 地区库与自动更新中配置 MaxMind Account ID / License Key。
# 后台保存到私有数据卷 .geo-credentials.json（0600；Windows 需限制数据目录 ACL），不入 SQLite、日志或响应。
# 以下任一环境变量非空时，整个环境凭据对优先；不与后台保存值混用，两项均须有效。
# 下载使用官方 HTTPS + Basic Auth。保留数据重装会保留后台凭据；可在后台单独清除。
GEO_ACCOUNT_ID=
GEO_LICENSE_KEY=
# 自动更新开关与节奏（小时，1-168）+ 抖动（秒，0-21600，避免所有实例同一秒请求）。
# 手动与自动检查共用互斥及尝试预算：至少间隔 10 分钟，每天最多 30 次（失败也计数）。
# 活动库必须具备有效 build_epoch，构建超过 30 天后 enforce 返回 503；这是应用的新鲜度策略。
GEO_UPDATE_ENABLED=true
# 后台保存的更新周期优先于此默认值；修改后台周期无需重启。
GEO_UPDATE_INTERVAL_HOURS=12
GEO_UPDATE_JITTER_SECONDS=1800
# 生产下载目的地固定为 MaxMind 官方 HTTPS 及其受控存储重定向，不接受自定义下载地址。
# 上一把 License Key：仅用于日志脱敏，不参与下载、解密或验证。
# 轮换完成后应清空。与其他密钥一样只从环境变量读，不写库、不入日志、不返前端。
GEO_LICENSE_KEY_PREVIOUS=
# 误锁恢复出口：设为 true 时无论设置里是什么，一律按 off 运行（改完需重启容器）。
# 服务器侧也可以直接用 ./deploy.sh --geo-off 改库（运行中的进程 ≤5 秒生效，无需重启）。
GEO_ENFORCE_DISABLED=false
AUDIT_MAX_ROWS=100000
LOG_BACKUP_COUNT=5
LOG_FILE_ENABLED=true
# 审计告警表保留行数上限（100-5,000,000）。
AUDIT_ALERT_MAX_ROWS=20000
# 观看历史保留天数（0-3650；0 = 永久保留，不清理）。
VIEWER_WATCH_RETENTION_DAYS=180
# 日志页单次读取的字节上限（64 KiB - 16 MiB）。
LOG_TAIL_MAX_BYTES=2097152
# 完整日志 ZIP 的未压缩内容上限（默认 512 MiB，范围 1 MiB–2 GiB）。
# 超限明确报错，不会静默截断；每进程最多一个导出任务，生成最长 120 秒。
LOG_EXPORT_MAX_BYTES=536870912
# Docker 日志轮转：由 compose.yaml 的 logging 段消费（driver / options），
# 应用进程自己不读这三项 —— 改这里会改变容器日志的轮转策略。
SCRCPYGATE_LOG_DRIVER=local
SCRCPYGATE_LOG_MAX_SIZE=20m
SCRCPYGATE_LOG_MAX_FILES=5
